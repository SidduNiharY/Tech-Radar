[Unit]
Description=TechRadar Host Security Alerter Daemon
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=techradar
SupplementaryGroups=docker systemd-journal adm
WorkingDirectory=/home/techradar/TechRadarBrain
ExecStart=/home/techradar/TechRadarBrain/.venv/bin/python -m techradar.hostsec.alerter
Restart=always
RestartSec=5s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ReadWritePaths=/var/lib/techradar-alerter /home/techradar/TechRadarBrain/data/incidents

[Install]
WantedBy=multi-user.target
